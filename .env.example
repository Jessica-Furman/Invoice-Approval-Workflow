# --- Database ---
# Local dev default is SQLite (no install needed). To use Postgres (via docker-compose), set e.g.:
# DATABASE_URL=postgresql+psycopg2://invoicee:invoicee@localhost:5432/invoicee
DATABASE_URL=sqlite:///./data/invoicee.sqlite3

# --- Invoice parsing (M3) ---
# Claude API key used for the LLM fallback parser. Not required for the M1 UI demo.
ANTHROPIC_API_KEY=

# --- Local mock paths (relative to repo root) ---
INBOX_CONTRACTOR_DIR=./data/inbox/contractor_invoices
INBOX_MATCHED_DIR=./data/inbox/matched
INBOX_FLAGGED_DIR=./data/inbox/flagged
STORAGE_DIR=./data/storage
CLARITY_DIR=./data/clarity

# --- Frontend ---
# Base URL the React app uses to reach the backend.
VITE_API_BASE_URL=http://localhost:8000

# --- M8 (real integrations, not needed for MVP demo) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
